<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="KnowledgeCapture.Views.StoredDataPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:v="using:KnowledgeCapture.Views"
    xmlns:vm="using:KnowledgeCapture.ViewModels">

    <Grid Padding="24,4,24,24" RowSpacing="12" ColumnSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.ColumnSpan="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Stored data" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" Style="{StaticResource SecondaryCaption}" />
                <TextBlock Text="This is exactly what is on disk: anonymized text only. The placeholder mapping never leaves memory." Style="{StaticResource SecondaryCaption}" />
            </StackPanel>
            <Button Grid.Column="1" VerticalAlignment="Center" Command="{x:Bind ViewModel.RefreshCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1">
            <ListView ItemsSource="{x:Bind ViewModel.Conversations}" SelectionMode="Single" SelectionChanged="List_SelectionChanged"
                      ItemContainerStyle="{StaticResource StretchListItem}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:StoredConversationItem">
                        <StackPanel Padding="0,10" Spacing="3">
                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource SecondaryCaption}" />
                            <Grid ColumnSpacing="8" Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ProgressBar Value="{x:Bind CoveragePercent}" Maximum="100" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}">
                                    <Run Text="{x:Bind CoveragePercent}" /><Run Text="% coverage" />
                                </TextBlock>
                            </Grid>
                            <TextBlock Text="{x:Bind Entities}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock Text="Nothing stored yet. Finish a turn in Chat with storage on." Style="{StaticResource SecondaryCaption}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind v:Bind.Visible(ViewModel.IsEmpty), Mode=OneWay}" />
        </Grid>

        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardStyle}" Padding="16,16,8,8">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.SelectedTitle, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind ViewModel.SelectedMeta, Mode=OneWay}" Style="{StaticResource SecondaryCaption}" Margin="0,0,8,0" />
                </StackPanel>
                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.SelectedMessages}" SelectionMode="None"
                          ItemContainerStyle="{StaticResource StretchListItem}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:StoredMessageItem">
                            <StackPanel Padding="0,8" Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind RoleLabel}" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="12" />
                                    <TextBlock Text="{x:Bind Meta}" Style="{StaticResource SecondaryCaption}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock v:Highlight.Text="{x:Bind Text}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>
